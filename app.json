{
  "expo": {
    "name": "StickerSmash",
    "slug": "StickerSmash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/epn-app-icon.png",
    "scheme": "stickersmash",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7FA",
    "ios": {
      "icon": "./assets/images/epn-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9EDF3",
        "foregroundImage": "./assets/images/epn-logo-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.StickerSmash"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/epn-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9EDF3",
          "image": "./assets/images/epn-logo-1024.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
